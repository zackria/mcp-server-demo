{
  "name": "vendor-accreditation-mcp",
  "version": "1.0.0",
  "description": "MCP server for Procurement Agency vendor-accreditation system, deployed to Google Cloud Run with MongoDB Atlas backend",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "seed": "tsx scripts/seed.ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "mcp",
    "vendor",
    "accreditation",
    "procurement"
  ],
  "author": "Zack Dawood <zackria@gmail.com>",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "express": "^4.18.2",
    "mongodb": "^6.12.0",
    "zod": "^3.22.4",
    "dotenv": "^16.3.1",
    "pino": "^8.19.0"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "tsx": "^4.19.1",
    "@types/node": "^22.10.5",
    "@types/express": "^4.17.21",
    "pino-pretty": "^11.2.2"
  }
}
