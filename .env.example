MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-host>/<db>?retryWrites=true&w=majority
PORT=8080
LOG_LEVEL=info

# NOTE: No request-level authentication is implemented yet.
# Cloud Run IAM (--no-allow-unauthenticated) is the only current perimeter.
# A future pass will add AUTH_BEARER_TOKEN or IAM-identity validation here
# before this service is exposed to any non-trivial production traffic.
